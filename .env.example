# ---------- docker-compose (.env on the server) ----------

# Backend origin that nginx proxies /api/ to (runtime, no rebuild needed)
API_UPSTREAM=http://31.57.77.199:8080

# Port on the Linux host
HOST_PORT=80

# Hostname for nginx server_name ("_" = any)
SERVER_NAME=_

# ---------- build args (baked into the bundle) ----------

# Keep "/api/" so the browser calls the same origin and nginx forwards it.
VITE_APP_API=/api/

# redux-persist encryption key — change it
VITE_PERSIST_KEY=28dhi2hnH!pidubhp92n#@!cNJ

# CARTO Basemaps key for the map pages (azmap, worldmap).
# Get it at dashboard.basemaps.carto.com (not a CARTO Workspace token).
VITE_CARTO_BASEMAP_KEY=
